# Deployed sub-path. Default "/portfolio" (GitHub Pages); set to "" for a root/custom domain.
NEXT_PUBLIC_BASE_PATH=/portfolio
# Absolute site URL used for canonical, hreflang, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://ngqhuy-dev.github.io/portfolio

# Contact form endpoint (e.g. https://formspree.io/f/<id>). Empty = the form opens the visitor's mail app.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Cloudflare Turnstile site key. Only used when NEXT_PUBLIC_CONTACT_ENDPOINT is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Plausible Analytics site domain. Empty = no analytics script, no tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible script URL (self-hosted instance or a per-site script). Default: https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
